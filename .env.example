# Copy to .env (git-ignored) and fill in. Never commit .env.
DUET_HOST=192.168.x.x
DUET_PASSWORD=
DUET_READ_ONLY=true
# DUET_CAMERAS="notebook=dshow:Integrated Camera"
# DUET_MACROS=
# DUET_HEAT_IDLE_MINUTES=15
# Print supervision (see README, step A2). Defaults shown.
# DUET_SUPERVISOR=on            # off disables the background supervisor
# DUET_POLL_SECONDS=10          # polling while printing/heating; idle polls 3x slower
# DUET_TEMP_DEV_TOOL=15         # C away from target, once settled
# DUET_TEMP_DEV_BED=10
# DUET_TEMP_DEV_SECONDS=45
# DUET_HEATUP_MINUTES=8
# DUET_STALL_SECONDS=180
# DUET_STALL_ACTION=warn        # or pause
# DUET_CONN_LOSS_SECONDS=60
# Human confirmation (start_job, home_axes, heating, ...). auto = client dialog (MCP elicitation), then system dialog, then refuse.
# DUET_CONFIRM=auto             # auto | elicit | dialog | deny | model (model trusts the model's own confirm flag: unsafe)
# DUET_CONFIRM_TIMEOUT=120      # seconds; no answer counts as No
# DUET_CONFIRM_DIALOG=never     # never = do not use the system dialog
# Speed per layer (M220): from layer N on, N percent. Layer 1 is the first layer.
# DUET_SPEED_PROFILE=1:30,2:50,3:80,6:100
