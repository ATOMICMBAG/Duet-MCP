# Copy to .env (git-ignored) and fill in. Never commit .env.
DUET_HOST=192.168.x.x
DUET_PASSWORD=
DUET_READ_ONLY=true
# DUET_CAMERAS="notebook=dshow:Integrated Camera"
# DUET_CAMERA_NOTES="notebook=Overview of the bed;side=Side view at bed height"   # what each camera is for (separate with ;)
# DUET_IMAGE_DIR=duet-mcp-images # archive of the pictures the assistant saw (default shown; off = do not save)
# DUET_IMAGE_KEEP=200           # how many pictures the assistant looked at to keep
# DUET_VIEW_CROPS="filament=bed:0.28,0.0,0.20,0.46;leds=bed:0.53,0.04,0.12,0.30"   # cut-outs of a camera picture for the cockpit: name=camera:x,y,width,height (fractions 0..1)
# DUET_VIEWER_PORT=8765          # live viewer for the pictures on http://127.0.0.1:8765/ (this PC only, off by default)
# DUET_IMAGE_INTERVAL_SECONDS=0  # >0: also take a picture every N seconds (min 5) while a job is active, for the timeline
# DUET_IMAGE_AUTO_KEEP=300       # how many of these periodic pictures to keep
# DUET_CAMERA_WIDTH=960         # shrink pictures to this width (saves tokens, needs ffmpeg), 0 = original
# DUET_MACROS=
# DUET_HEAT_IDLE_MINUTES=15
# Print supervision (see README, step A2). Defaults shown.
# DUET_SUPERVISOR=on            # off disables the background supervisor
# DUET_POLL_SECONDS=10          # polling while printing/heating; idle polls 3x slower
# DUET_TEMP_DEV_TOOL=15         # C away from target, once settled
# DUET_TEMP_DEV_BED=10
# DUET_TEMP_DEV_SECONDS=45
# DUET_HEATUP_MINUTES=8
# DUET_STALL_SECONDS=180
# DUET_STALL_ACTION=warn        # or pause
# DUET_PAUSE_HOT_MINUTES=5      # warn when a pause with a hot nozzle lasts this long (3x: error), 0 = off
# DUET_CONN_LOSS_SECONDS=60
# Human confirmation (start_job, home_axes, heating, ...). auto = client dialog (MCP elicitation), then system dialog, then refuse.
# DUET_CONFIRM=auto             # auto | elicit | dialog | deny | model (model trusts the model's own confirm flag: unsafe)
# DUET_CONFIRM_TIMEOUT=120      # seconds; no answer counts as No
# DUET_CONFIRM_DIALOG=never     # never = do not use the system dialog
# Speed per layer (M220): from layer N on, N percent. Layer 1 is the first layer.
# DUET_SPEED_PROFILE=1:30,2:50,3:80,6:100
# DUET_AUDIT_READS=on            # also log the read-only calls (to see what an assistant did during a test)
# DUET_AUDIT_KEY=               # secret for the audit log checksums (HMAC); same key for duet-mcp-verify-audit
